rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Hardcoded admin email fallback — works even if user doc has no role field
    function isHardcodedAdmin() {
      return isSignedIn() && request.auth.token.email != null &&
        request.auth.token.email.lower() == "kuzeykoc587@gmail.com";
    }

    function isAdminOrMod() {
      return isSignedIn() && (
        isHardcodedAdmin() ||
        getUserData().role == "ADMIN" ||
        getUserData().role == "MODERATOR"
      );
    }

    function isBanned() {
      return isSignedIn() && getUserData().isBanned == true;
    }

    function hasNoModFields(data) {
      return !("approvedBy" in data)
          && !("rejectedBy" in data)
          && !("hiddenBy" in data)
          && !("approvedAt" in data)
          && !("rejectedAt" in data)
          && !("hiddenAt" in data)
          && !("status" in data);
    }

    function userCannotElevateRole(data) {
      return !("role" in data) || data.role == null;
    }

    // ── Users ─────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && hasNoModFields(request.resource.data) && userCannotElevateRole(request.resource.data);
      allow update: if (
        isOwner(userId) &&
        !("role" in request.resource.data.diff(resource.data).affectedKeys()) &&
        !("isBanned" in request.resource.data.diff(resource.data).affectedKeys())
      ) || isAdminOrMod();
      allow delete: if false;
    }

    // ── Tests ─────────────────────────────────────────────────────
    match /tests/{testId} {
      allow read: if true;
      allow create: if isSignedIn() && !isBanned() && hasNoModFields(request.resource.data);
      allow update: if (
        isOwner(resource.data.creatorId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "status", "moderationStatus", "riskScore", "riskReasons",
          "approvedBy", "approvedAt", "rejectedBy", "rejectedAt",
          "hiddenBy", "hiddenAt", "creatorId"
        ])
      ) || isAdminOrMod();
      allow delete: if isOwner(resource.data.creatorId) || isAdminOrMod();
    }

    // ── Duels ─────────────────────────────────────────────────────
    match /duels/{duelId} {
      allow read: if true;
      allow create: if isSignedIn() && !isBanned();
      allow update: if isOwner(resource.data.creatorId) || isAdminOrMod();
      allow delete: if isOwner(resource.data.creatorId) || isAdminOrMod();
    }

    // ── Universes ─────────────────────────────────────────────────
    match /universes/{universeId} {
      allow read: if true;
      allow create: if isSignedIn() && !isBanned();
      allow update: if (
        isOwner(resource.data.creatorId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "status", "creatorId", "updatedBy"
        ])
      ) || isAdminOrMod();
      allow delete: if isAdminOrMod();
    }

    // ── Characters ────────────────────────────────────────────────
    match /characters/{characterId} {
      allow read: if true;
      allow create: if isSignedIn() && !isBanned();
      allow update: if (
        isOwner(resource.data.creatorId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "status", "creatorId", "updatedBy"
        ])
      ) || isAdminOrMod();
      allow delete: if isAdminOrMod();
    }

    // ── This or That ──────────────────────────────────────────────
    match /thisOrThat/{itemId} {
      allow read: if true;
      allow create: if isSignedIn() && !isBanned();
      allow update: if (
        isOwner(resource.data.creatorId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "status", "creatorId", "updatedBy"
        ])
      ) || isAdminOrMod();
      allow delete: if isAdminOrMod();
    }

    // ── Tier Lists ────────────────────────────────────────────────
    match /tierlists/{listId} {
      allow read: if true;
      allow create: if isSignedIn() && !isBanned();
      allow update: if isOwner(resource.data.creatorId) || isAdminOrMod();
      allow delete: if isOwner(resource.data.creatorId) || isAdminOrMod();
    }

    // ── Tier List Results ─────────────────────────────────────────
    match /tierlistResults/{resultId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isOwner(resource.data.userId);
      allow delete: if false;
    }

    // ── Tier Votes ────────────────────────────────────────────────
    match /tierVotes/{voteId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ── Likes ─────────────────────────────────────────────────────
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── Favorites ─────────────────────────────────────────────────
    match /favorites/{favId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── Notifications ─────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ── Reports ───────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if isAdminOrMod();
      allow create: if isSignedIn() && !isBanned() && request.resource.data.reportedBy == request.auth.uid;
      allow update: if isAdminOrMod();
      allow delete: if false;
    }

  }
}
